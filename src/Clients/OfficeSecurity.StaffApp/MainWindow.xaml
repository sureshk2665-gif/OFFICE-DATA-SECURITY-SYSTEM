<Window x:Class="OfficeSecurity.StaffApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:OfficeSecurity.Client.Wpf;assembly=OfficeSecurity.Client.Wpf"
        xmlns:vm="clr-namespace:OfficeSecurity.StaffApp.ViewModels"
        Title="Office Computer Security — Staff"
        Width="560" Height="680" MinWidth="460" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Brush.Background}"
        FontFamily="{StaticResource Font.Main}">
  <Window.Resources>
    <ui:StatusToBrushConverter x:Key="StatusToBrush" />
  </Window.Resources>
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="28,24">
      <TextBlock Text="Office Security" Style="{StaticResource Text.PageTitle}" Margin="0,0,0,4" />
      <TextBlock Text="Development build · Phase 1" Style="{StaticResource Text.Muted}" Margin="0,0,0,16" />

      <Border Style="{StaticResource Card}">
        <StackPanel Orientation="Horizontal">
          <Ellipse Width="12" Height="12" Margin="0,0,10,0" VerticalAlignment="Center"
                   Fill="{Binding IsServerReachable, Converter={StaticResource StatusToBrush}}" />
          <TextBlock Text="{Binding ServerStatusText}" Style="{StaticResource Text.Body}" VerticalAlignment="Center" />
        </StackPanel>
      </Border>

      <Border Style="{StaticResource Card}">
        <StackPanel>
          <TextBlock Text="Security and privacy notice" Style="{StaticResource Text.SectionTitle}" />
          <TextBlock Text="{x:Static vm:StaffMainViewModel.SecurityNotice}" Style="{StaticResource Text.Body}" />
        </StackPanel>
      </Border>

      <Border Style="{StaticResource Card}">
        <StackPanel>
          <TextBlock Text="Staff sign-in" Style="{StaticResource Text.SectionTitle}" />
          <Border Style="{StaticResource Banner.Info}">
            <TextBlock Text="{x:Static vm:StaffMainViewModel.SignInUnavailableText}" Style="{StaticResource Text.Body}" />
          </Border>
          <TextBlock Text="Employee code" Style="{StaticResource Text.Muted}" Margin="0,0,0,4" />
          <TextBox Style="{StaticResource TextBox.Field}" IsEnabled="False" Margin="0,0,0,10" />
          <TextBlock Text="Password" Style="{StaticResource Text.Muted}" Margin="0,0,0,4" />
          <PasswordBox Style="{StaticResource PasswordBox.Field}" IsEnabled="False" Margin="0,0,0,14" />
          <Button Content="Sign in" Style="{StaticResource Button.Primary}" IsEnabled="False" HorizontalAlignment="Left" />
        </StackPanel>
      </Border>

      <Border Style="{StaticResource Card}">
        <StackPanel>
          <TextBlock Text="Request software" Style="{StaticResource Text.SectionTitle}" />
          <TextBlock Text="{x:Static vm:StaffMainViewModel.RequestUnavailableText}" Style="{StaticResource Text.Muted}" />
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</Window>
