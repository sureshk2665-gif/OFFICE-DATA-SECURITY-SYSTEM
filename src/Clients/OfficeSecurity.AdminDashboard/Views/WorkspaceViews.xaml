<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="clr-namespace:OfficeSecurity.AdminDashboard.ViewModels"
                    xmlns:ui="clr-namespace:OfficeSecurity.Client.Wpf;assembly=OfficeSecurity.Client.Wpf">

  <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="pack://application:,,,/OfficeSecurity.Client.Wpf;component/Themes/SharedViews.xaml" />
  </ResourceDictionary.MergedDictionaries>

  <!-- ============================== workspace frame ============================== -->
  <DataTemplate DataType="{x:Type vm:WorkspaceViewModel}">
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="240" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <DockPanel Background="{StaticResource Brush.Sidebar}">
        <StackPanel DockPanel.Dock="Top" Margin="20,24,20,20">
          <TextBlock Text="Office Security" Foreground="White" FontSize="18" FontWeight="SemiBold" />
          <TextBlock Text="Administrator dashboard" Foreground="{StaticResource Brush.SidebarText}" FontSize="12" />
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom" Margin="20,12,20,16">
          <TextBlock Text="{Binding UserText}" Foreground="{StaticResource Brush.SidebarText}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,8" />
          <Button Content="Sign out" Command="{Binding SignOutCommand}" Style="{StaticResource Button.Secondary}" HorizontalAlignment="Left" />
          <TextBlock Text="Development build · Phase 3" Foreground="{StaticResource Brush.SidebarText}" FontSize="11" Margin="0,12,0,0" />
        </StackPanel>
        <ListBox Style="{StaticResource NavList}" ItemsSource="{Binding Sections}" SelectedItem="{Binding SelectedSection}" DisplayMemberPath="Title" />
      </DockPanel>

      <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
        <ContentControl Content="{Binding SelectedSection}" Margin="32,28" />
      </ScrollViewer>
    </Grid>
  </DataTemplate>

  <!-- ============================== overview ============================== -->
  <DataTemplate DataType="{x:Type vm:OverviewViewModel}">
    <StackPanel>
      <TextBlock Text="Overview" Style="{StaticResource Text.PageTitle}" />
      <ContentControl Content="{Binding}" ContentTemplate="{StaticResource Messages}" />
      <Border Style="{StaticResource Card}">
        <StackPanel>
          <TextBlock Text="Central server" Style="{StaticResource Text.SectionTitle}" />
          <StackPanel Orientation="Horizontal" Margin="0,4,0,4">
            <Ellipse Width="12" Height="12" Margin="0,0,8,0" VerticalAlignment="Center"
                     Fill="{Binding IsServerReachable, Converter={StaticResource StatusToBrush}}" />
            <TextBlock Text="{Binding ServerText}" Style="{StaticResource Text.Body}" VerticalAlignment="Center" />
          </StackPanel>
          <TextBlock Text="{Binding ServerAddress}" Style="{StaticResource Text.Muted}" Margin="0,0,0,12" />
          <Button Content="Refresh" Command="{Binding RefreshCommand}" IsEnabled="{Binding IsNotBusy}" Style="{StaticResource Button.Secondary}" HorizontalAlignment="Left" />
        </StackPanel>
      </Border>
      <UniformGrid Columns="3" Margin="0,0,0,0">
        <Border Style="{StaticResource Card}" Margin="0,0,12,16">
          <StackPanel>
            <TextBlock Text="Staff accounts" Style="{StaticResource Text.Muted}" />
            <TextBlock Text="{Binding Overview.StaffTotal, FallbackValue=—}" FontSize="30" FontWeight="SemiBold" />
            <TextBlock Style="{StaticResource Text.Muted}">
              <Run Text="{Binding Overview.StaffActive, Mode=OneWay, FallbackValue=0}" /><Run Text=" active · " /><Run Text="{Binding Overview.StaffPendingActivation, Mode=OneWay, FallbackValue=0}" /><Run Text=" waiting · " /><Run Text="{Binding Overview.StaffDisabled, Mode=OneWay, FallbackValue=0}" /><Run Text=" disabled" />
            </TextBlock>
          </StackPanel>
        </Border>
        <Border Style="{StaticResource Card}" Margin="0,0,12,16">
          <StackPanel>
            <TextBlock Text="Active administrators" Style="{StaticResource Text.Muted}" />
            <TextBlock Text="{Binding Overview.AdministratorsActive, FallbackValue=—}" FontSize="30" FontWeight="SemiBold" />
          </StackPanel>
        </Border>
        <Border Style="{StaticResource Card}" Margin="0,0,0,16">
          <StackPanel>
            <TextBlock Text="Failed sign-ins (24 hours)" Style="{StaticResource Text.Muted}" />
            <TextBlock Text="{Binding Overview.FailedLoginsLast24Hours, FallbackValue=—}" FontSize="30" FontWeight="SemiBold" />
          </StackPanel>
        </Border>
      </UniformGrid>
      <UniformGrid Columns="4">
        <Border Style="{StaticResource Card}" Margin="0,0,12,16">
          <StackPanel>
            <TextBlock Text="Approved computers" Style="{StaticResource Text.Muted}" />
            <TextBlock Text="{Binding Overview.ComputersTrusted, FallbackValue=—}" FontSize="30" FontWeight="SemiBold" />
          </StackPanel>
        </Border>
        <Border Style="{StaticResource Card}" Margin="0,0,12,16">
          <StackPanel>
            <TextBlock Text="Online / offline" Style="{StaticResource Text.Muted}" />
            <TextBlock FontSize="30" FontWeight="SemiBold">
              <Run Text="{Binding Overview.ComputersOnline, Mode=OneWay, FallbackValue=—}" /><Run Text=" / " /><Run Text="{Binding Overview.ComputersOffline, Mode=OneWay, FallbackValue=—}" />
            </TextBlock>
          </StackPanel>
        </Border>
        <Border Style="{StaticResource Card}" Margin="0,0,12,16">
          <StackPanel>
            <TextBlock Text="Waiting for approval" Style="{StaticResource Text.Muted}" />
            <TextBlock Text="{Binding Overview.ComputersPendingApproval, FallbackValue=—}" FontSize="30" FontWeight="SemiBold" />
          </StackPanel>
        </Border>
        <Border Style="{StaticResource Card}" Margin="0,0,0,16">
          <StackPanel>
            <TextBlock Text="With failed security controls" Style="{StaticResource Text.Muted}" />
            <TextBlock Text="{Binding Overview.ComputersWithFailedControls, FallbackValue=—}" FontSize="30" FontWeight="SemiBold" />
          </StackPanel>
        </Border>
      </UniformGrid>
      <Border Style="{StaticResource Card}">
        <StackPanel>
          <TextBlock Text="Alerts and blocked transfers" Style="{StaticResource Text.SectionTitle}" />
          <TextBlock Style="{StaticResource Text.Muted}" TextWrapping="Wrap"
                     Text="Blocking starts in Phase 5 and alerts in Phase 6. The dashboard never shows sample or estimated figures." />
        </StackPanel>
      </Border>
    </StackPanel>
  </DataTemplate>

  <!-- ============================== planned section ============================== -->
  <DataTemplate DataType="{x:Type vm:PlannedSectionViewModel}">
    <StackPanel>
      <TextBlock Text="{Binding Title}" Style="{StaticResource Text.PageTitle}" />
      <Border Style="{StaticResource Banner.Info}">
        <TextBlock Text="{Binding PhaseText}" Style="{StaticResource Text.Body}" FontWeight="SemiBold" />
      </Border>
      <Border Style="{StaticResource Card}">
        <StackPanel>
          <TextBlock Text="What this section will do" Style="{StaticResource Text.SectionTitle}" />
          <TextBlock Text="{Binding Description}" Style="{StaticResource Text.Body}" />
        </StackPanel>
      </Border>
    </StackPanel>
  </DataTemplate>

  <!-- ============================== issued setup code banner (shared by staff and admins) ============================== -->
  <DataTemplate x:Key="IssuedCode">
    <Border Style="{StaticResource Banner.Success}" Visibility="{Binding HasIssuedCode, Converter={StaticResource BoolToVisibility}}">
      <StackPanel>
        <TextBlock Style="{StaticResource Text.Body}" FontWeight="SemiBold">
          <Run Text="One-time setup code for " /><Run Text="{Binding IssuedCode.LoginName, Mode=OneWay}" />
        </TextBlock>
        <TextBox Text="{Binding IssuedCode.SetupCode, Mode=OneWay}" Style="{StaticResource Text.Code}" Margin="0,4,0,4" />
        <TextBlock Style="{StaticResource Text.Muted}">
          <Run Text="Give this code to the person privately. It works once and expires on " /><Run Text="{Binding IssuedCode.ExpiresAtUtc, Mode=OneWay, Converter={StaticResource LocalTime}}" /><Run Text=". It will not be shown again." />
        </TextBlock>
        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
          <Button Content="Copy code" Command="{Binding CopyCodeCommand}" Style="{StaticResource Button.Primary}" />
          <Button Content="Done" Command="{Binding DismissCodeCommand}" Style="{StaticResource Button.Secondary}" Margin="8,0,0,0" />
        </StackPanel>
      </StackPanel>
    </Border>
  </DataTemplate>

  <!-- ============================== staff accounts ============================== -->
  <DataTemplate DataType="{x:Type vm:StaffViewModel}">
    <StackPanel>
      <TextBlock Text="Staff Accounts" Style="{StaticResource Text.PageTitle}" />
      <ContentControl Content="{Binding}" ContentTemplate="{StaticResource Messages}" />
      <ContentControl Content="{Binding}" ContentTemplate="{StaticResource IssuedCode}" />

      <Border Style="{StaticResource Card}" Visibility="{Binding IsCreateOpen, Converter={StaticResource BoolToVisibility}}">
        <StackPanel MaxWidth="460" HorizontalAlignment="Left">
          <TextBlock Text="Add staff member" Style="{StaticResource Text.SectionTitle}" />
          <TextBlock Text="Employee code (what they sign in with)" Style="{StaticResource Text.Label}" />
          <TextBox Text="{Binding NewEmployeeCode, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource TextBox.Field}" />
          <TextBlock Text="Full name" Style="{StaticResource Text.Label}" />
          <TextBox Text="{Binding NewDisplayName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource TextBox.Field}" />
          <TextBlock Text="Department (optional)" Style="{StaticResource Text.Label}" />
          <TextBox Text="{Binding NewDepartment, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource TextBox.Field}" />
          <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
            <Button Content="Create account" Command="{Binding CreateCommand}" IsEnabled="{Binding IsNotBusy}" Style="{StaticResource Button.Primary}" />
            <Button Content="Cancel" Command="{Binding CloseFormsCommand}" Style="{StaticResource Button.Secondary}" Margin="8,0,0,0" />
          </StackPanel>
        </StackPanel>
      </Border>

      <Border Style="{StaticResource Card}" Visibility="{Binding IsEditOpen, Converter={StaticResource BoolToVisibility}}">
        <StackPanel MaxWidth="460" HorizontalAlignment="Left">
          <TextBlock Style="{StaticResource Text.SectionTitle}">
            <Run Text="Edit " /><Run Text="{Binding Selected.EmployeeCode, Mode=OneWay}" />
          </TextBlock>
          <TextBlock Text="Full name" Style="{StaticResource Text.Label}" />
          <TextBox Text="{Binding EditDisplayName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource TextBox.Field}" />
          <TextBlock Text="Department (optional)" Style="{StaticResource Text.Label}" />
          <TextBox Text="{Binding EditDepartment, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource TextBox.Field}" />
          <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
            <Button Content="Save" Command="{Binding SaveEditCommand}" IsEnabled="{Binding IsNotBusy}" Style="{StaticResource Button.Primary}" />
            <Button Content="Cancel" Command="{Binding CloseFormsCommand}" Style="{StaticResource Button.Secondary}" Margin="8,0,0,0" />
          </StackPanel>
        </StackPanel>
      </Border>

      <Border Style="{StaticResource Card}">
        <StackPanel>
          <DockPanel Margin="0,0,0,12">
            <Button DockPanel.Dock="Right" Content="Add staff member" Command="{Binding OpenCreateCommand}" Style="{StaticResource Button.Primary}"
                    Visibility="{Binding CanWrite, Converter={StaticResource BoolToVisibility}}" />
            <StackPanel Orientation="Horizontal">
              <TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource TextBox.Field}" Width="240" ToolTip="Search by name, employee code or department" />
              <ComboBox ItemsSource="{Binding StatusFilters}" SelectedItem="{Binding StatusFilter}" Width="200" Margin="8,0,0,0" VerticalContentAlignment="Center" />
              <Button Content="Search" Command="{Binding ApplyFilterCommand}" IsDefault="True" Style="{StaticResource Button.Secondary}" Margin="8,0,0,0" />
            </StackPanel>
          </DockPanel>

          <DataGrid ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}" Style="{StaticResource Grid.Table}" MinHeight="240" MaxHeight="520">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Employee code" Binding="{Binding EmployeeCode}" Width="130" />
              <DataGridTextColumn Header="Name" Binding="{Binding DisplayName}" Width="*" />
              <DataGridTextColumn Header="Department" Binding="{Binding Department}" Width="150" />
              <DataGridTextColumn Header="Status" Binding="{Binding Status, Converter={StaticResource AccountStatusText}}" Width="180" />
              <DataGridCheckBoxColumn Header="Locked" Binding="{Binding IsLocked}" Width="70" />
              <DataGridTextColumn Header="Last sign-in" Binding="{Binding LastLoginAtUtc, Converter={StaticResource LocalTime}}" Width="150" />
            </DataGrid.Columns>
          </DataGrid>

          <DockPanel Margin="0,12,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
              <Button Content="Previous" Command="{Binding PreviousPageCommand}" Style="{StaticResource Button.Secondary}" />
              <Button Content="Next" Command="{Binding NextPageCommand}" Style="{StaticResource Button.Secondary}" Margin="8,0,0,0" />
            </StackPanel>
            <TextBlock Text="{Binding PageText}" Style="{StaticResource Text.Muted}" VerticalAlignment="Center" />
          </DockPanel>

          <StackPanel Orientation="Horizontal" Margin="0,16,0,0" Visibility="{Binding CanWrite, Converter={StaticResource BoolToVisibility}}"
                      IsEnabled="{Binding HasSelection}">
            <Button Content="Edit" Command="{Binding OpenEditCommand}" Style="{StaticResource Button.Secondary}" />
            <Button Content="Issue new setup code" Command="{Binding ResetCommand}" Style="{StaticResource Button.Secondary}" Margin="8,0,0,0" />
            <Button Content="Enable" Command="{Binding EnableCommand}" Style="{StaticResource Button.Secondary}" Margin="8,0,0,0" />
            <Button Content="Disable" Command="{Binding DisableCommand}" Style="{StaticResource Button.Danger}" Margin="8,0,0,0" />
          </StackPanel>
        </StackPanel>
      </Border>
    </StackPanel>
  </DataTemplate>

  <!-- ============================== administrators ============================== -->
  <DataTemplate DataType="{x:Type vm:AdministratorsViewModel}">
    <StackPanel>
      <TextBlock Text="Administrators" Style="{StaticResource Text.PageTitle}" />
      <ContentControl Content="{Binding}" ContentTemplate="{StaticResource Messages}" />
      <ContentControl Content="{Binding}" ContentTemplate="{StaticResource IssuedCode}" />

      <Border Style="{StaticResource Card}" Visibility="{Binding IsCreateOpen, Converter={StaticResource BoolToVisibility}}">
        <StackPanel MaxWidth="460" HorizontalAlignment="Left">
          <TextBlock Text="Add administrator" Style="{StaticResource Text.SectionTitle}" />
          <TextBlock Text="User name" Style="{StaticResource Text.Label}" />
          <TextBox Text="{Binding NewUsername, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource TextBox.Field}" />
          <TextBlock Text="Full name" Style="{StaticResource Text.Label}" />
          <TextBox Text="{Binding NewDisplayName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource TextBox.Field}" />
          <TextBlock Text="Role: SuperAdmin manages administrators · Admin manages everything else · Auditor can only view" Style="{StaticResource Text.Label}" TextWrapping="Wrap" />
          <ComboBox ItemsSource="{Binding Roles}" SelectedItem="{Binding NewRole}" Width="200" HorizontalAlignment="Left" />
          <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
            <Button Content="Create administrator" Command="{Binding CreateCommand}" IsEnabled="{Binding IsNotBusy}" Style="{StaticResource Button.Primary}" />
            <Button Content="Cancel" Command="{Binding CloseCreateCommand}" Style="{StaticResource Button.Secondary}" Margin="8,0,0,0" />
          </StackPanel>
        </StackPanel>
      </Border>

      <Border Style="{StaticResource Card}">
        <StackPanel>
          <DockPanel Margin="0,0,0,12">
            <Button DockPanel.Dock="Right" Content="Add administrator" Command="{Binding OpenCreateCommand}" Style="{StaticResource Button.Primary}" />
            <TextBlock Text="Every administrator signs in with a password and an authenticator app code." Style="{StaticResource Text.Muted}" VerticalAlignment="Center" />
          </DockPanel>
          <DataGrid ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}" Style="{StaticResource Grid.Table}" MinHeight="160">
            <DataGrid.Columns>
              <DataGridTextColumn Header="User name" Binding="{Binding Username}" Width="150" />
              <DataGridTextColumn Header="Name" Binding="{Binding DisplayName}" Width="*" />
              <DataGridTextColumn Header="Role" Binding="{Binding Role}" Width="110" />
              <DataGridTextColumn Header="Status" Binding="{Binding Status, Converter={StaticResource AccountStatusText}}" Width="180" />
              <DataGridCheckBoxColumn Header="Two-step" Binding="{Binding MfaEnabled}" Width="80" />
              <DataGridTextColumn Header="Last sign-in" Binding="{Binding LastLoginAtUtc, Converter={StaticResource LocalTime}}" Width="150" />
            </DataGrid.Columns>
          </DataGrid>
          <StackPanel Orientation="Horizontal" Margin="0,16,0,0" IsEnabled="{Binding CanChangeSelected}">
            <Button Content="Reset password and two-step" Command="{Binding ResetCommand}" Style="{StaticResource Button.Secondary}" />
            <Button Content="Enable" Command="{Binding EnableCommand}" Style="{StaticResource Button.Secondary}" Margin="8,0,0,0" />
            <Button Content="Disable" Command="{Binding DisableCommand}" Style="{StaticResource Button.Danger}" Margin="8,0,0,0" />
          </StackPanel>
        </StackPanel>
      </Border>
    </StackPanel>
  </DataTemplate>

  <!-- ============================== audit log ============================== -->
  <DataTemplate DataType="{x:Type vm:AuditViewModel}">
    <StackPanel>
      <TextBlock Text="Audit Logs" Style="{StaticResource Text.PageTitle}" />
      <ContentControl Content="{Binding}" ContentTemplate="{StaticResource Messages}" />
      <Border Style="{StaticResource Card}" Visibility="{Binding HasVerification, Converter={StaticResource BoolToVisibility}}">
        <StackPanel Orientation="Horizontal">
          <Ellipse Width="12" Height="12" Margin="0,0,8,0" VerticalAlignment="Center"
                   Fill="{Binding Verification.IsIntact, Converter={StaticResource StatusToBrush}}" />
          <TextBlock Text="{Binding Verification.Message}" Style="{StaticResource Text.Body}" VerticalAlignment="Center" />
        </StackPanel>
      </Border>
      <Border Style="{StaticResource Card}">
        <StackPanel>
          <DockPanel Margin="0,0,0,12">
            <Button DockPanel.Dock="Right" Content="Verify integrity" Command="{Binding VerifyCommand}" IsEnabled="{Binding IsNotBusy}" Style="{StaticResource Button.Primary}"
                    ToolTip="Recalculates the tamper-evident hash chain of the whole audit log" />
            <StackPanel Orientation="Horizontal">
              <TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource TextBox.Field}" Width="260" ToolTip="Search by action, user or details" />
              <Button Content="Search" Command="{Binding ApplyFilterCommand}" IsDefault="True" Style="{StaticResource Button.Secondary}" Margin="8,0,0,0" />
            </StackPanel>
          </DockPanel>
          <DataGrid ItemsSource="{Binding Items}" Style="{StaticResource Grid.Table}" MinHeight="300" MaxHeight="600">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Time" Binding="{Binding OccurredAtUtc, Converter={StaticResource LocalTime}, ConverterParameter='dd MMM yyyy HH:mm:ss'}" Width="160" />
              <DataGridTextColumn Header="Action" Binding="{Binding Action}" Width="200" />
              <DataGridTextColumn Header="Result" Binding="{Binding Outcome}" Width="80" />
              <DataGridTextColumn Header="By" Binding="{Binding ActorName}" Width="130" />
              <DataGridTextColumn Header="From" Binding="{Binding SourceIp}" Width="120" />
              <DataGridTextColumn Header="Details" Binding="{Binding Details}" Width="*" />
            </DataGrid.Columns>
          </DataGrid>
          <DockPanel Margin="0,12,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
              <Button Content="Previous" Command="{Binding PreviousPageCommand}" Style="{StaticResource Button.Secondary}" />
              <Button Content="Next" Command="{Binding NextPageCommand}" Style="{StaticResource Button.Secondary}" Margin="8,0,0,0" />
            </StackPanel>
            <TextBlock Text="{Binding PageText}" Style="{StaticResource Text.Muted}" VerticalAlignment="Center" />
          </DockPanel>
        </StackPanel>
      </Border>
    </StackPanel>
  </DataTemplate>

  <!-- ============================== settings ============================== -->
  <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
    <StackPanel>
      <TextBlock Text="Settings" Style="{StaticResource Text.PageTitle}" />
      <Border Style="{StaticResource Card}">
        <StackPanel>
          <TextBlock Text="Change your password" Style="{StaticResource Text.SectionTitle}" />
          <ContentControl Content="{Binding ChangePassword}" />
        </StackPanel>
      </Border>
      <Border Style="{StaticResource Card}">
        <StackPanel>
          <TextBlock Text="Server connection" Style="{StaticResource Text.SectionTitle}" />
          <TextBlock Text="{Binding ServerAddress, StringFormat='Connected to {0} using a verified, pinned certificate.'}" Style="{StaticResource Text.Body}" Margin="0,0,0,12" />
          <Button Content="Disconnect and connect to a different server" Command="{Binding ForgetServerCommand}" Style="{StaticResource Button.Secondary}" HorizontalAlignment="Left" />
        </StackPanel>
      </Border>
    </StackPanel>
  </DataTemplate>
</ResourceDictionary>
