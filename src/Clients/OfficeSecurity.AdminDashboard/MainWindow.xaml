<Window x:Class="OfficeSecurity.AdminDashboard.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:OfficeSecurity.AdminDashboard.ViewModels"
        xmlns:ui="clr-namespace:OfficeSecurity.Client.Wpf;assembly=OfficeSecurity.Client.Wpf"
        Title="Office Computer Security — Administrator Dashboard"
        Width="1200" Height="760" MinWidth="900" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Brush.Background}"
        FontFamily="{StaticResource Font.Main}">
  <Window.Resources>
    <ui:StatusToBrushConverter x:Key="StatusToBrush" />

    <DataTemplate DataType="{x:Type vm:OverviewViewModel}">
      <StackPanel>
        <TextBlock Text="Overview" Style="{StaticResource Text.PageTitle}" />
        <Border Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock Text="Central server connection" Style="{StaticResource Text.SectionTitle}" />
            <StackPanel Orientation="Horizontal" Margin="0,4,0,4">
              <Ellipse Width="12" Height="12" Margin="0,0,8,0" VerticalAlignment="Center"
                       Fill="{Binding IsServerReachable, Converter={StaticResource StatusToBrush}}" />
              <TextBlock Text="{Binding ServerStatusText}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock Text="{Binding ServerAddress, StringFormat=Address: {0}}" Style="{StaticResource Text.Muted}" />
            <TextBlock Text="{Binding ServerDetails}" Style="{StaticResource Text.Muted}" Margin="0,2,0,12" />
            <Button Content="Check again" Command="{Binding CheckServerCommand}" Style="{StaticResource Button.Primary}" HorizontalAlignment="Left" />
          </StackPanel>
        </Border>
        <Border Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock Text="Office statistics" Style="{StaticResource Text.SectionTitle}" />
            <TextBlock Style="{StaticResource Text.Muted}"
                       Text="Computer counts, alerts, blocked transfers and pending requests will appear here once computers are registered (Phase 3 onwards). This dashboard never shows sample or estimated figures." />
          </StackPanel>
        </Border>
      </StackPanel>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:PlannedSectionViewModel}">
      <StackPanel>
        <TextBlock Text="{Binding Title}" Style="{StaticResource Text.PageTitle}" />
        <Border Style="{StaticResource Banner.Info}">
          <TextBlock Text="{Binding PhaseText}" Style="{StaticResource Text.Body}" FontWeight="SemiBold" />
        </Border>
        <Border Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock Text="What this section will do" Style="{StaticResource Text.SectionTitle}" />
            <TextBlock Text="{Binding Description}" Style="{StaticResource Text.Body}" />
          </StackPanel>
        </Border>
      </StackPanel>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
      <StackPanel MaxWidth="560" HorizontalAlignment="Left">
        <TextBlock Text="Settings" Style="{StaticResource Text.PageTitle}" />
        <Border Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock Text="Central server address" Style="{StaticResource Text.SectionTitle}" />
            <TextBlock Text="The address of the office computer running Office Security Server." Style="{StaticResource Text.Muted}" Margin="0,0,0,8" />
            <TextBox Text="{Binding ServerAddress, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource TextBox.Field}" Margin="0,0,0,12" />
            <StackPanel Orientation="Horizontal">
              <Button Content="Save" Command="{Binding SaveCommand}" Style="{StaticResource Button.Primary}" />
              <TextBlock Text="{Binding Message}" Style="{StaticResource Text.Muted}" VerticalAlignment="Center" Margin="12,0,0,0" />
            </StackPanel>
          </StackPanel>
        </Border>
      </StackPanel>
    </DataTemplate>
  </Window.Resources>

  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="240" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <DockPanel Background="{StaticResource Brush.Sidebar}">
      <StackPanel DockPanel.Dock="Top" Margin="20,24,20,20">
        <TextBlock Text="Office Security" Foreground="White" FontSize="18" FontWeight="SemiBold" />
        <TextBlock Text="Administrator" Foreground="{StaticResource Brush.SidebarText}" FontSize="12" />
      </StackPanel>
      <TextBlock DockPanel.Dock="Bottom" Margin="20,12" Foreground="{StaticResource Brush.SidebarText}" FontSize="11"
                 Text="Development build · Phase 1" />
      <ListBox Style="{StaticResource NavList}" ItemsSource="{Binding Sections}" SelectedItem="{Binding SelectedSection}"
               DisplayMemberPath="Title" />
    </DockPanel>

    <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
      <ContentControl Content="{Binding SelectedSection}" Margin="32,28" />
    </ScrollViewer>
  </Grid>
</Window>
