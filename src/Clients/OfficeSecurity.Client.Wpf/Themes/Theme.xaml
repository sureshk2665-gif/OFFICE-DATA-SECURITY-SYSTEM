<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Palette -->
  <SolidColorBrush x:Key="Brush.Background" Color="#F4F6F9" />
  <SolidColorBrush x:Key="Brush.Surface" Color="#FFFFFF" />
  <SolidColorBrush x:Key="Brush.Sidebar" Color="#1E2A3A" />
  <SolidColorBrush x:Key="Brush.SidebarHover" Color="#2B3A4F" />
  <SolidColorBrush x:Key="Brush.SidebarSelected" Color="#2F6FEB" />
  <SolidColorBrush x:Key="Brush.SidebarText" Color="#D6DEE8" />
  <SolidColorBrush x:Key="Brush.Text" Color="#1B2430" />
  <SolidColorBrush x:Key="Brush.TextMuted" Color="#5B6675" />
  <SolidColorBrush x:Key="Brush.Border" Color="#DCE1E8" />
  <SolidColorBrush x:Key="Brush.Accent" Color="#2F6FEB" />
  <SolidColorBrush x:Key="Brush.Success" Color="#1E8E3E" />
  <SolidColorBrush x:Key="Brush.Warning" Color="#B26A00" />
  <SolidColorBrush x:Key="Brush.Danger" Color="#C5221F" />
  <SolidColorBrush x:Key="Brush.InfoBackground" Color="#FFF6E0" />

  <FontFamily x:Key="Font.Main">Segoe UI</FontFamily>

  <Style x:Key="Text.PageTitle" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource Font.Main}" />
    <Setter Property="FontSize" Value="24" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
    <Setter Property="Margin" Value="0,0,0,16" />
  </Style>

  <Style x:Key="Text.SectionTitle" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource Font.Main}" />
    <Setter Property="FontSize" Value="15" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
    <Setter Property="Margin" Value="0,0,0,8" />
  </Style>

  <Style x:Key="Text.Body" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource Font.Main}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <Style x:Key="Text.Muted" TargetType="TextBlock" BasedOn="{StaticResource Text.Body}">
    <Setter Property="Foreground" Value="{StaticResource Brush.TextMuted}" />
  </Style>

  <Style x:Key="Card" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource Brush.Surface}" />
    <Setter Property="BorderBrush" Value="{StaticResource Brush.Border}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="20" />
    <Setter Property="Margin" Value="0,0,0,16" />
  </Style>

  <Style x:Key="Banner.Info" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource Brush.InfoBackground}" />
    <Setter Property="BorderBrush" Value="{StaticResource Brush.Warning}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="12,8" />
    <Setter Property="Margin" Value="0,0,0,16" />
  </Style>

  <Style x:Key="Button.Primary" TargetType="Button">
    <Setter Property="FontFamily" Value="{StaticResource Font.Main}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Foreground" Value="White" />
    <Setter Property="Background" Value="{StaticResource Brush.Accent}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="16,8" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Root" Property="Opacity" Value="0.9" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Root" Property="Opacity" Value="0.45" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="TextBox.Field" TargetType="TextBox">
    <Setter Property="FontFamily" Value="{StaticResource Font.Main}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Padding" Value="8,6" />
    <Setter Property="BorderBrush" Value="{StaticResource Brush.Border}" />
  </Style>

  <Style x:Key="PasswordBox.Field" TargetType="PasswordBox">
    <Setter Property="FontFamily" Value="{StaticResource Font.Main}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Padding" Value="8,6" />
    <Setter Property="BorderBrush" Value="{StaticResource Brush.Border}" />
  </Style>

  <!-- Sidebar navigation list -->
  <Style x:Key="NavItem" TargetType="ListBoxItem">
    <Setter Property="Foreground" Value="{StaticResource Brush.SidebarText}" />
    <Setter Property="FontFamily" Value="{StaticResource Font.Main}" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListBoxItem">
          <Border x:Name="Root" Background="Transparent" Padding="20,10" Margin="8,1" CornerRadius="6">
            <ContentPresenter />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Root" Property="Background" Value="{StaticResource Brush.SidebarHover}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="Root" Property="Background" Value="{StaticResource Brush.SidebarSelected}" />
              <Setter Property="Foreground" Value="White" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="NavList" TargetType="ListBox">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="ItemContainerStyle" Value="{StaticResource NavItem}" />
    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
  </Style>
</ResourceDictionary>
